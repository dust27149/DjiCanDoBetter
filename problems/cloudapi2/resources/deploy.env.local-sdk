# ============================================================================
# FH Skeleton 本地部署配置（Docker Compose + SDK 模式）
# 说明: SDK profile 加载 SDK JNI 原生库，连接真实 FlightHub PaaS 平台。
#       如在 Apple Silicon 上运行，需设置 DOCKER_DEFAULT_PLATFORM=linux/amd64。
# ============================================================================

# ─── 运行模式 ──────────────────────────────────────────────────────────────
FH_PROFILE=sdk
SDK_ARCH=amd64

# ─── 数据库（本地 compose 内置 MySQL 8.0）────────────────────────────────────
# 使用 openssl rand -hex 24 生成
MYSQL_ROOT_PASSWORD=8d787bf7d4cc48f0b3fa64d3efc69826dd8a8c070d2e5a63
FH_DB_USERNAME=root
# 值同 MYSQL_ROOT_PASSWORD
FH_DB_PASSWORD=8d787bf7d4cc48f0b3fa64d3efc69826dd8a8c070d2e5a63
FH_DB_USE_SSL=false

# ─── JWT 签名密钥（必填，HS256 至少 32 字节）────────────────────────────────
# 生成方式：openssl rand -hex 32
# 警告：CHANGE_ME 开头的值会被启动校验拒绝，
#       必须替换成随机值，否则后端启动即失败。
FH_JWT_SECRET=c78946bd91b281dcb84cc555b84501ea480fd4cc90ec9b0983c7666beeeb39fc

# ─── Spring AI（占位值，不配则 AnthropicApi Bean 初始化报 null）─────────────
SPRING_AI_ANTHROPIC_API_KEY=not-configured
SPRING_AI_OPENAI_API_KEY=not-configured

# ─── MCP / Chat（关闭：本地无 MCP Server）──────────────────────────────────
FH_CHAT_ENABLED=false
FH_CHAT_MCP_URL=http://localhost:8080
FH_CHAT_MCP_AUTH_TOKEN=

# ─── SDK 凭据 ──────────────────────────────────────────────────────────────
# 开放注册，默认 false。初始化首个账号时临时设为 true，首个注册用户自动成为 admin，创建完成后务必改回 false
FH_USER_REGISTRATION_ENABLED=true
FH_SKELETON_SDK_TOKEN=
# 上云2 底座IP
FH_SKELETON_SDK_ADDRESS=192.168.5.100
# 上云2 后端服务端口，默认为30812
FH_SKELETON_SDK_PORT=30812
# ws://上云2底座IP:上云2后端服务端口/openapi/v0.9/notification/ws/v1/notifications
FH_SKELETON_SDK_NOTIFICATION_SERVER=ws://192.168.5.100:30812/openapi/v0.9/notification/ws/v1/notifications

# ─── SDK HTTP 鉴权 Header（平台网关鉴权）────────────────────────────────────
FH_SKELETON_SDK_AUTH_HEADER_KEY=user_id
FH_SKELETON_SDK_AUTH_HEADER_VALUE=paas_test

# ─── 前端 FH2 配置 ─────────────────────────────────────────────────────────
# 上云2 底座IP
VITE_FH2_ADDRESS=http://192.168.5.100
# 上云2 后端服务端口，默认为30812
VITE_FH2_PORT=30812
# ws://上云2底座IP:上云2后端服务端口/openapi/v0.9/notification/ws/v1/notifications
VITE_FH2_WSS_URL=ws://192.168.5.100:30812/openapi/v0.9/notification/ws/v1/notifications
VITE_FH2_PRJ_ID=
# ⚠️ 前端 SDK Auth Key/Value — 设备管理 SDK 需要此 header 鉴权连接 FH2 平台
VITE_FH2_SDK_AUTH_KEY=user_id
VITE_FH2_SDK_AUTH_VALUE=paas_test
VITE_FH2_DEVICE_SDK_ENABLED=true
VITE_DEFAULT_THEME=dark
VITE_PRIMARY_COLOR=#1a73e8
VITE_PRIMARY_HOVER_COLOR=
VITE_MOCK_ENABLED=false
VITE_MAP_PROVIDER=esri
VITE_BING_KEY=
VITE_TIANDITU_KEY=
